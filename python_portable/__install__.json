      },
      "Help": {
        "Online Python Documentation": {
          "_": "https://docs.python.org/3.11/"
        },
        "Main Python Documentation": {
          "_": "%PREFIX%Doc\\html\\index.html"
        }
      }
    },
    {
      "kind": "start",
      "Name": "Python 3.11",
      "Items": [
        {
          "Name": "Python 3.11",
          "Target": "%PREFIX%python.exe",
          "Icon": "%PREFIX%python.exe"
        },
        {
          "Name": "Python 3.11 Online Documentation",
          "Icon": "%SystemRoot%\\System32\\SHELL32.dll",
          "IconIndex": 13,
          "Target": "https://docs.python.org/3.11/"
        },
        {
          "Name": "IDLE (Python 3.11)",
          "Target": "%PREFIX%pythonw.exe",
          "Arguments": "\"%PREFIX%Lib\\idlelib\\idle.pyw\"",
          "Icon": "%PREFIX%Lib\\idlelib\\Icons\\idle.ico",
          "IconIndex": 0
        },
        {
          "Name": "PyDoc (Python 3.11)",
          "Target": "%PREFIX%python.exe",
          "Arguments": "-m pydoc -b",
          "Icon": "%PREFIX%Lib\\idlelib\\Icons\\idle.ico",
          "IconIndex": 0
        },
        {
          "Name": "Python 3.11 Manuals",
          "Target": "%PREFIX%Doc\\html\\index.html"
        }
      ]
    },
    {
      "kind": "uninstall",
      "Publisher": "Python Software Foundation",
      "HelpLink": "https://docs.python.org/3.11/"
    }
